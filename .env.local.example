# Copy to .env.local, set chmod 600, and fill values through the approved secret channel.
# Never commit the populated file. The SSH key and database role must be read-only.
LEGACY_SSH_HOST=legacy-host.example
LEGACY_SSH_USER=legacy-tunnel
LEGACY_SSH_PORT=22
LEGACY_SSH_IDENTITY_FILE=

LEGACY_DB_HOST=127.0.0.1
LEGACY_DB_PORT=10110
LEGACY_DB_REMOTE_HOST=127.0.0.1
LEGACY_DB_REMOTE_PORT=5432
LEGACY_DB_NAME=
LEGACY_DB_USER=
LEGACY_DB_PASSWORD=
LEGACY_DB_SSLMODE=prefer
