# Environment Configuration Template
# Run `make configure-local-infra`; it copies this template and injects the
# ignored credentials managed by ../shared-local-infrastructure.

# Database Configuration
POSTGRES_DB=eceee_v4
POSTGRES_USER=local_eceee_v4
POSTGRES_PASSWORD=
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=10300
DATABASE_URL=

# Django Configuration
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOWED_ORIGINS=http://localhost:10100,http://127.0.0.1:10100

# React Configuration
REACT_APP_API_URL=http://localhost:10101/api
REACT_APP_BACKEND_URL=http://localhost:10101

# GitHub Integration (for MCP servers)
GITHUB_TOKEN=your_github_personal_access_token_here

# How-to video generation (local only; keep real keys in .env, never commit them)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_ENG=
ELEVENLABS_VOICE_ID_SWE=
ANTHROPIC_API_KEY=
HOWTO_LANGUAGE=sv
HOWTO_TRANSLATION_PROVIDER=anthropic
HOWTO_TRANSLATION_MODEL=
HOWTO_TRANSLATION_MODEL_FALLBACKS=claude-3-5-haiku-latest,claude-3-haiku-20240307
HOWTO_TRANSLATION_FALLBACK=original
HOWTO_NARRATION_PADDING_MS=1200
ELEVENLABS_MAX_RETRIES=3
HOWTO_PROD_BASE_URL=https://app.eceee.org
HOWTO_AUTH_STATE=.auth/eceee-prod-storage-state.json
HOWTO_OUTPUT_BASE_DIR=frontend/howto-video-output/prod

# Development Settings
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Shared Redis and MinIO credentials are populated by configure-local-infra.
REDIS_URL=
ECEEE_REDIS_NAMESPACE=eceee_v4
AWS_ACCESS_KEY_ID=eceee-v4
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=eceee-media
AWS_S3_ENDPOINT_URL=http://localhost:10302
AWS_S3_INTERNAL_ENDPOINT_URL=http://host.docker.internal:10302

# Security Settings (for production)
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_INCLUDE_SUBDOMAINS=True
# SECURE_HSTS_PRELOAD=True
# SECURE_CONTENT_TYPE_NOSNIFF=True
# SECURE_BROWSER_XSS_FILTER=True
# X_FRAME_OPTIONS=DENY
