# Environment Configuration Template
# Copy this file to .env and fill in your specific values

# Database Configuration
POSTGRES_DB=eceee_v4
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://postgres:postgres@db:5432/eceee_v4

# Django Configuration
SECRET_KEY=dev-secret-key-change-in-production
DEBUG=1
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# React Configuration
REACT_APP_API_URL=http://localhost:8000/api
REACT_APP_BACKEND_URL=http://localhost:8000

# GitHub Integration (for MCP servers)
GITHUB_TOKEN=your_github_personal_access_token_here

# How-to video generation (local only; keep real keys in .env, never commit them)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID_ENG=
ELEVENLABS_VOICE_ID_SWE=
ANTHROPIC_API_KEY=
HOWTO_LANGUAGE=sv
HOWTO_TRANSLATION_PROVIDER=anthropic
HOWTO_TRANSLATION_MODEL=
HOWTO_TRANSLATION_MODEL_FALLBACKS=claude-3-5-haiku-latest,claude-3-haiku-20240307
HOWTO_TRANSLATION_FALLBACK=original
HOWTO_NARRATION_PADDING_MS=1200
ELEVENLABS_MAX_RETRIES=3
HOWTO_PROD_BASE_URL=https://app.eceee.org
HOWTO_AUTH_STATE=.auth/eceee-prod-storage-state.json
HOWTO_OUTPUT_BASE_DIR=frontend/howto-video-output/prod

# Development Settings
CHOKIDAR_USEPOLLING=true
WATCHPACK_POLLING=true

# Redis Configuration (optional)
REDIS_URL=redis://redis:6379/0

# Security Settings (for production)
# SECURE_SSL_REDIRECT=True
