    {
      "id": "headline-camel-header-level-parser-gap",
      "description": "The wire parser maps headerLevel to header_level, while HeadlineConfig names its field headerLevel. The validation endpoint silently returns the h1 default for a nondefault headerLevel. This characterizes the existing bug; it does not approve it for the replacement."
    }
  ],
