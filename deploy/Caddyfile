# Caddyfile for ECEEE v4 Production - Multi-Site Architecture
# Caddy automatically handles HTTPS/TLS certificates via Let's Encrypt
# Domain is configured via DOMAIN env var (e.g. eceee.org)

{
    email {$EMAIL:noreply@eceee.org}
}

# Parallel TypeScript publisher. The application maps these browser-facing test
# hostnames to their public source hosts only for content lookup, so redirects
# and form submissions stay on the isolated test hostnames.
eceee-test.colliberty.com, summerstudy-test.colliberty.com, industry-test.colliberty.com {
    encode gzip
    header X-Robots-Tag "noindex, nofollow, noarchive"

    handle_path /imgproxy/* {
        reverse_proxy imgproxy:8080
    }

    reverse_proxy publisher:3000
}

# Public Content Sites - Next publisher serving public pages. Django retains
# the CMS/API and compatibility asset routes; it does not render page requests.
summerstudy.{$DOMAIN}, industry.{$DOMAIN} {
    encode gzip

    handle /admin* {
        redir https://admin.{$DOMAIN}{uri} permanent
    }

    handle_path /imgproxy/* {
        reverse_proxy imgproxy:8080
    }

    # Public forms are validated and stored by the publisher. This must remain
    # before the broader Django API route below.
    handle /api/forms/* {
        reverse_proxy publisher:3000
    }

    handle /static/* {
        reverse_proxy backend:8000
    }

    handle /media/* {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle /* {
        header X-ECEEE-Renderer "nextjs"
        reverse_proxy publisher:3000
    }
}

# Django Admin Site
admin.{$DOMAIN} {
    encode gzip
    reverse_proxy backend:8000
}

# React CMS Editor - Frontend application for content editing
app.{$DOMAIN} {
    encode gzip

    # WebSocket connections to Django Channels
    handle /ws/* {
        reverse_proxy backend:8000
    }

    # CSRF token endpoint
    handle /csrf-token* {
        reverse_proxy backend:8000
    }

    # API calls go to backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Same-origin imgproxy URLs emitted by backend-generated theme CSS
    handle /imgproxy/* {
        reverse_proxy backend:8000
    }

    # Static files from backend
    handle /static/* {
        reverse_proxy backend:8000
    }

    # Media files from backend
    handle /media/* {
        reverse_proxy backend:8000
    }

    # Health check
    handle /health/* {
        reverse_proxy backend:8000
    }

    # Metrics
    handle /metrics/* {
        reverse_proxy backend:8000
    }

    # Everything else goes to React app
    handle /* {
        reverse_proxy frontend:80
    }
}

# imgproxy - Image processing service
imgproxy.{$DOMAIN} {
    encode gzip
    reverse_proxy imgproxy:8080
}
